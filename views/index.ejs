<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>CORS + Proxy Study</title>
  </head>
  <body>
    <h1>Frontend Page</h1>
    <button id="loadData">Load API Data</button>
    <pre id="output"></pre>

    <script>
      document
        .getElementById("loadData")
        .addEventListener("click", async () => {
          try {
            const res = await fetch("http://3.108.119.62:4000/hello", {
              method: "GET",
              // credentials: "include", // This includes credentials like cookies
            });
            const data = await res.json();
            document.getElementById("output").innerText = JSON.stringify(
              data,
              null,
              2
            );
          } catch (err) {
            document.getElementById("output").innerText =
              "Error: " + err.message;
          }
        });
    </script>
  </body>
</html>
